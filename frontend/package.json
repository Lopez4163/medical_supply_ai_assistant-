{
  "name": "biomedichospicare-ai-supply-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "cd ../backend && uv run python -m scripts.generate_openapi && cd ../frontend && openapi-typescript ../backend/openapi.json -o src/lib/api/generated.ts",
    "check:api-types": "npm run generate:api-types && git diff --exit-code -- src/lib/api/generated.ts ../backend/openapi.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.108.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.0",
    "openapi-typescript": "^7.12.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
