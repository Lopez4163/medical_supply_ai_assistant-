# Local-only PostgreSQL configuration for Docker Compose and backend commands.
POSTGRES_USER=medical_supply_app
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=medical_supply
DATABASE_URL=postgresql+psycopg://medical_supply_app:local-development-password@127.0.0.1:55432/medical_supply
TEST_DATABASE_URL=postgresql+psycopg://medical_supply_app:local-development-password@127.0.0.1:55432/medical_supply_test
APP_ENVIRONMENT=development
CHAT_PROVIDER=mock
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Generate a unique local value with at least 32 characters. Never reuse production secrets.
SESSION_TOKEN_HASH_SECRET=replace-with-a-local-development-secret-at-least-32-characters
